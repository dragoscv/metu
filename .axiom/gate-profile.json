{
  "deny": [
    ".git/**",
    ".axiom/**",
    ".github/**",
    "pnpm-lock.yaml",
    "**/*.lock",
    "**/drizzle/meta/**",
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**"
  ],
  "noSecrets": true,
  "pii": true,
  "maxBytes": 262144,
  "commands": {
    "pack": "house"
  },
  "coordination": {
    "marksDir": "~/.codai/coord/marks",
    "leasesDir": "~/.codai/coord/leases",
    "slotsRoot": "${env:CODAI_WT_ROOT:-E:/gh/.wt}",
    "exemptVia": ["agentq\\.ps1"]
  },
  "git": {
    "cleanTreeFor": ["deploy"],
    "untracked": true
  },
  "mode": "warn",
  "override": true,
  "outside": "allow",
  "hard": ["house.forcePush", "house.resetHard", "house.cleanForce", "house.worktreeRemoveForce"],
  "record": true
}
